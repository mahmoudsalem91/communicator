{
  "name": "communicator",
  "productName": "Communicator",
  "version": "0.4.0",
  "description": "Low-latency peer-to-peer voice rooms for friends.",
  "homepage": "https://github.com/mahmoudsalem91/communicator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoudsalem91/communicator.git"
  },
  "bugs": {
    "url": "https://github.com/mahmoudsalem91/communicator/issues"
  },
  "main": "src/main.js",
  "author": {
    "name": "MooDy Shalaby",
    "url": "https://landingweb.app"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:second": "electron . --profile=second",
    "dist": "electron-builder --win",
    "release": "node --env-file=.env node_modules/electron-builder/cli.js --win --publish always"
  },
  "build": {
    "appId": "se.communicator.app",
    "productName": "Communicator",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mahmoudsalem91",
        "repo": "communicator",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
